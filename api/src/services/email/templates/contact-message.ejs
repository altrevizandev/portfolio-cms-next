<!doctype html>
<html lang="pt-BR">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Novo contato pelo portfólio</title></head>
  <body style="margin:0;background:#101214;color:#edf2f6;font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 16px;background:#101214;"><tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;overflow:hidden;border:1px solid #2b353f;border-radius:22px;background:#161a1e;">
        <tr><td style="height:5px;background:#9ed4f5;font-size:0;">&nbsp;</td></tr>
        <tr><td style="padding:32px;">
          <div style="color:#9ed4f5;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;">Novo contato pelo portfólio</div>
          <h1 style="margin:14px 0 26px;font-size:28px;line-height:1.2;"><%= subject %></h1>
          <div style="padding:18px;border:1px solid #2b353f;border-radius:16px;background:#101214;">
            <div style="font-size:15px;font-weight:700;"><%= name %></div>
            <div style="margin-top:5px;color:#9ed4f5;font-size:14px;"><%= email %></div>
            <% if (phone) { %>
              <div style="margin-top:5px;color:#9ed4f5;font-size:14px;">WhatsApp / telefone: <%= phone %></div>
            <% } %>
          </div>
          <div style="margin-top:24px;color:#d5edfc;font-size:15px;line-height:1.8;white-space:pre-wrap;"><%= message %></div>
        </td></tr>
        <tr><td style="padding:18px 32px;border-top:1px solid #2b353f;background:#14191e;color:#a2afbc;font-size:12px;">Use “Responder” para falar diretamente com <%= name %>.</td></tr>
      </table>
    </td></tr></table>
  </body>
</html>
