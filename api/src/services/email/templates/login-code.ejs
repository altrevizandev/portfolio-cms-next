<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Seu código de acesso</title>
  </head>
  <body style="margin:0;background:#101214;color:#edf2f6;font-family:Arial,Helvetica,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Seu código de acesso ao CMS expira em <%= expires_in_minutes %> minutos.</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#101214;padding:40px 16px;">
      <tr><td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#161a1e;border:1px solid #2b353f;border-radius:24px;overflow:hidden;">
          <tr>
            <td style="height:5px;background:#9ed4f5;font-size:0;">&nbsp;</td>
          </tr>
          <tr>
            <td style="padding:34px 34px 24px;">
              <table role="presentation" cellpadding="0" cellspacing="0"><tr>
                <td style="width:44px;height:44px;background:#9ed4f5;color:#102331;border-radius:14px;text-align:center;font-size:14px;font-weight:800;">AT</td>
                <td style="padding-left:14px;">
                  <div style="font-size:15px;font-weight:700;">André Lucas Trevizan</div>
                  <div style="margin-top:3px;color:#a2afbc;font-size:11px;letter-spacing:2px;text-transform:uppercase;">Portfolio CMS</div>
                </td>
              </tr></table>
              <h1 style="margin:34px 0 12px;font-size:30px;line-height:1.15;letter-spacing:-1px;color:#edf2f6;">Confirme seu acesso.</h1>
              <p style="margin:0;color:#a2afbc;font-size:15px;line-height:1.7;">Olá, <strong style="color:#edf2f6;"><%= account.name %></strong>. Use o código abaixo para concluir o login.</p>
            </td>
          </tr>
          <tr>
            <td style="padding:0 34px 34px;">
              <div style="background:#101214;border:1px solid #3b4b5a;border-radius:18px;padding:24px;text-align:center;color:#9ed4f5;font-size:36px;font-weight:800;letter-spacing:12px;"><%= code %></div>
              <p style="margin:20px 0 0;color:#a2afbc;font-size:13px;line-height:1.6;text-align:center;">Válido por <strong style="color:#9ed4f5;"><%= expires_in_minutes %> minutos</strong>. Nunca compartilhe este código.</p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 34px;background:#14191e;border-top:1px solid #2b353f;color:#a2afbc;font-size:12px;line-height:1.6;">Se você não tentou acessar o CMS, ignore este e-mail com segurança.</td>
          </tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
