<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Bem-vindo ao Portfolio CMS</title>
  </head>
  <body style="margin:0;background:#0b0d16;color:#f5f6fc;font-family:Arial,Helvetica,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Sua conta administrativa no Portfolio CMS está pronta.</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#0b0d16;padding:40px 16px;">
      <tr><td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#131621;border:1px solid #2b3040;border-radius:24px;overflow:hidden;">
          <tr><td style="height:5px;background:linear-gradient(90deg,#a78bfa,#2dd4bf);font-size:0;">&nbsp;</td></tr>
          <tr>
            <td style="padding:34px;">
              <table role="presentation" cellpadding="0" cellspacing="0"><tr>
                <td style="width:44px;height:44px;background:#a78bfa;color:#17102f;border-radius:14px;text-align:center;font-size:14px;font-weight:800;">AT</td>
                <td style="padding-left:14px;"><div style="font-size:15px;font-weight:700;">André Lucas Trevizan</div><div style="margin-top:3px;color:#aeb4c8;font-size:11px;letter-spacing:2px;text-transform:uppercase;">Portfolio CMS</div></td>
              </tr></table>
              <h1 style="margin:34px 0 12px;font-size:30px;line-height:1.15;letter-spacing:-1px;">Sua conta está pronta.</h1>
              <p style="margin:0 0 24px;color:#aeb4c8;font-size:15px;line-height:1.7;">Olá, <strong style="color:#f5f6fc;"><%= account.name %></strong>. Use os dados abaixo para acessar o painel administrativo.</p>
              <div style="padding:20px;background:#0b0d16;border:1px solid #2b3040;border-radius:18px;">
                <div style="color:#7f879d;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;">E-mail</div>
                <div style="margin-top:6px;font-size:15px;"><%= account.email %></div>
                <div style="margin-top:20px;color:#7f879d;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;">Senha temporária</div>
                <div style="margin-top:8px;color:#2dd4bf;font-size:24px;font-weight:800;letter-spacing:3px;"><%= password %></div>
              </div>
              <a href="<%= portal_url %>/sign-in" style="display:inline-block;margin-top:26px;background:#a78bfa;color:#17102f;text-decoration:none;padding:14px 22px;border-radius:999px;font-size:14px;font-weight:800;">Acessar o CMS</a>
            </td>
          </tr>
          <tr><td style="padding:20px 34px;background:#10131d;border-top:1px solid #2b3040;color:#7f879d;font-size:12px;line-height:1.6;">Por segurança, mantenha suas credenciais em local protegido.</td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
