# Ambiente
NODE_ENV=production
PORT=3333
APP_URL=https://altrevizan.com.br/api
PORTAL_URL=https://altrevizan.com.br

# PostgreSQL
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://portfolio:troque-esta-senha@portfolio-db:5432/portfolio

# Autenticação
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
ADMIN_NAME=André Lucas Trevizan
ADMIN_EMAIL=seu-email@dominio.com
ADMIN_PASSWORD=troque-esta-senha
PASS_CHARS=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ
PASS_NUMBERS=0123456789
PASS_SPECIAL_CHARS=!@#$%&*

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_AUTH=seu-email@dominio.com
MAIL_PASS=senha-de-aplicativo
MAIL_FROM=André Lucas Trevizan <seu-email@dominio.com>
MAIL_CONTACT_TO=seu-email@dominio.com

# reCAPTCHA Enterprise
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/recaptcha-auth.json
RECAPTCHA_CREDENTIALS_FILE=/opt/portfolio/google/recaptcha-auth.json
RECAPTCHA_PROJECT_ID=seu-projeto-google-cloud
RECAPTCHA_SITE_KEY=sua-chave-do-site
RECAPTCHA_MIN_SCORE=0.5

# Frontend
NEXT_PUBLIC_SITE_URL=https://altrevizan.com.br
NEXT_PUBLIC_API_URL=https://altrevizan.com.br/api
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=sua-chave-do-site

# Docker/VPS
PORTFOLIO_DATA_DIR=/opt/portfolio
REVERSE_PROXY_NETWORK=reverse-proxy

# Rate limits
RATE_LIMIT_MAX=300
RATE_LIMIT_TIME_WINDOW=1 minute
RATE_LIMIT_SIGN_IN_MAX=5
RATE_LIMIT_SIGN_IN_TIME_WINDOW=1 minute
RATE_LIMIT_VERIFY_CODE_MAX=5
RATE_LIMIT_VERIFY_CODE_TIME_WINDOW=1 minute
RATE_LIMIT_SEND_RESET_PASS_LINK_MAX=5
RATE_LIMIT_SEND_RESET_PASS_LINK_TIME_WINDOW=1 minute
RATE_LIMIT_CHANGE_PASSWORD_MAX=5
RATE_LIMIT_CHANGE_PASSWORD_TIME_WINDOW=1 minute
RATE_LIMIT_RESET_PASS_MAX=5
RATE_LIMIT_RESET_PASS_TIME_WINDOW=1 minute
